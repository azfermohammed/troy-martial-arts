# Copy to .env.local and fill in. .env.local is gitignored.
#
# ---------------------------------------------------------------- Supabase
# Both values come from the Supabase dashboard: Project Settings → API
#
# The publishable key is PUBLIC by design. It ends up in the client bundle of
# any static site and cannot be hidden — which is fine, because it only
# identifies the project. What it is allowed to do is enforced by row-level
# security in Postgres:
#
#   leads       anonymous visitors may INSERT (the public trial form),
#               and may not SELECT — not even rows they just wrote
#   students    staff only, or a student reading their own record
#   payments    admin only, or a student reading their own balance
#   attendance  staff write, student reads their own
#   messages    the two participants only
#
# The SERVICE ROLE key bypasses all of that. It must never be committed, never
# be prefixed NEXT_PUBLIC_, and never be used from the browser.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# -------------------------------------------------------------------- Site
# Absolute base URL for canonical links, sitemap.xml and JSON-LD.
#   Local:        http://localhost:3000
#   GitHub Pages: https://<user>.github.io/troy-martial-arts
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Subpath the site is served from. Empty locally, "/troy-martial-arts" on
# GitHub Pages. The deploy workflow sets this automatically.
NEXT_PUBLIC_BASE_PATH=
